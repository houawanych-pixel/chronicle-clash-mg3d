config_version=5
[application]
config/name="Chronicle Clash — Sky Citadel"
run/main_scene="res://scenes/citadel.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
[autoload]
InventoryService="*res://scripts/cc/survival/inventory_service.gd"
CookingService="*res://scripts/cc/survival/cooking_service.gd"
StaminaPool="*res://scripts/cc/survival/stamina_pool.gd"
WorldClock="*res://scripts/cc/survival/world_clock.gd"
SaveService="*res://scripts/cc/survival/save_service.gd"
TimeDilation="*res://scripts/cc/combat/time_dilation.gd"
CombatFx="*res://scripts/cc/combat/combat_fx.gd"
WeatherService="*res://scripts/cc/world/weather_service.gd"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.018,0.034,0.065,1)
textures/default_filters/use_nearest_mipmap_filter=false
[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[navigation]

3d/merge_rasterizer_cell_scale=0.001
